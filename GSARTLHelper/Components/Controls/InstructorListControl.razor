@using GSARTLHelper.Models
<h3>Instructors</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>SAR Group</th>
        </tr>
    </thead>

    @foreach (Participant participant in AllParticipants)
    {
        <tr>
            <td>@participant.FirstName</td>
            <td>@participant.LastName</td>
            <td>@participant.SarGroupName</td>
        </tr>
    }

</table>

@code {
    [Parameter]
    public List<Participant> AllParticipants { get; set; } = new List<Participant>();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        
    }

}
