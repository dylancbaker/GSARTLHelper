@using GSARTLHelper.Models
<h3>Scenario Assignment Grid</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <td></td>
            @for (int x = 1; x <= AllInstructors.Count; x++)
            {
                <th>
                    Area @x
                </th>
            }
        </tr>
        <tr>
            <th>Scenario</th>

            @foreach(Participant inst in AllParticipants.Where(o=>o.Type == ParticipantType.Instructor))
            {
                <th>@inst.FullName<br />
                    <em>@inst.SarGroupName</em>
                </th>
            }
        </tr>
        @foreach (Scenario scenario in AllScenarios.Where(o=>AllScenarioAssignments.Any(a => a.ScenarioId == o.Id)))
        {
            <tr>
                <th scope="row">@scenario.Name</th>
               @foreach(Participant inst in AllParticipants.Where(o=>o.Type == ParticipantType.Instructor))
                {
                    <td>
                        @GetScenarioParticipant(scenario.Id, inst.Id)?.FullName<br />
                        <em>@GetScenarioParticipant(scenario.Id, inst.Id)?.SarGroupName</em>
                    </td>
                }
                
            </tr>
        }
    </thead>
</table>


@code {
    [Parameter]
    public List<ScenarioAssignment> AllScenarioAssignments { get; set; } = new List<ScenarioAssignment>();
    [Parameter]
    public List<Participant> AllParticipants { get; set; } = new List<Participant>();
    List<Participant> AllInstructors { get => AllParticipants.Where(o => o.Type == ParticipantType.Instructor).ToList(); }
    [Parameter]
    public List<Scenario> AllScenarios { get; set; } = new List<Scenario>();

    private Participant? GetScenarioParticipant (Guid ScenarioId, Guid InstructorId)
    {
        ScenarioAssignment? assignment = AllScenarioAssignments.FirstOrDefault(o => o.InstructorId == InstructorId && o.ScenarioId == ScenarioId);
        if (assignment == null)
        {
            return null;
        }
        return AllParticipants.FirstOrDefault(o=>o.Id == assignment.StudentId);
    }

    
    

}
